{
  "name": "epub-reader-engine",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "description": "Browser EPUB reading system with CSS-fragmentation pagination for horizontal and vertical writing, image-page handling, fixed-layout support and a React adapter.",
  "scripts": {
    "typecheck": "npm run typecheck:core && npm run typecheck:react",
    "docs:diagrams": "node scripts/docs/export-doc-diagrams.mjs",
    "boundaries:check": "node scripts/verification/check-module-boundaries.mjs",
    "test": "node scripts/verification/run-tests.mjs",
    "test:unit": "node scripts/verification/run-tests.mjs unit",
    "test:integration": "node scripts/verification/run-tests.mjs integration",
    "check": "npm run boundaries:check && npm run typecheck && npm test",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "typecheck:react": "tsc -p tsconfig.react.json",
    "typecheck:verify": "tsc -p tsconfig.react.verify.json",
    "check:verify": "npm run boundaries:check && npm run typecheck:core && npm run typecheck:verify && npm test",
    "corpus:generate": "node scripts/corpus/generate-local-corpus.mjs",
    "corpus:test": "node scripts/corpus/run-local-corpus.mjs",
    "stress:parser": "node --expose-gc scripts/performance/run-parser-stress.mjs",
    "epubcheck:corpus": "node scripts/conformance/run-epubcheck.mjs fixtures/corpus",
    "browser:probe": "node scripts/conformance/probe-browser-runtime.mjs",
    "browser:interactions": "node scripts/conformance/run-browser-interactions.mjs",
    "browser:check": "npm run browser:probe && npm run browser:interactions",
    "conformance:pagination": "node scripts/conformance/run-pagination-conformance.mjs",
    "visual:check": "node scripts/conformance/check-visual-baselines.mjs",
    "hardening": "npm run check:verify && npm run corpus:test && npm run stress:parser",
    "conformance:w3c:observe": "node scripts/conformance/run-w3c-loader-observations.mjs",
    "conformance:w3c:report": "node scripts/conformance/create-w3c-report.mjs",
    "realworld:bind": "node scripts/corpus/bind-real-world-corpus.mjs",
    "realworld:test": "node scripts/corpus/run-real-world-corpus.mjs",
    "performance:realworld": "node --expose-gc scripts/performance/run-performance-baseline.mjs",
    "hardening:realworld": "npm run hardening && npm run realworld:test"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
