    {
      "id": "text-vertical-desktop",
      "source": {
        "kind": "fixture",
        "file": "vertical-ruby.epub"
      },
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "contentType": "text-vertical",
      "state": "reading",
      "baseline": "baselines/text-vertical-desktop.png",
      "note": "Vertical Japanese with ruby. Pagination is CSS fragmentation, so no line may be cut by a page boundary and the furigana of the first column of each page must stay inside the page. The numeric form of this is asserted per engine by npm run conformance:pagination."
    },
    {
      "id": "mixed-layout-text-desktop",
      "source": {
        "kind": "fixture",
        "file": "mixed-layout.epub"
      },
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "contentType": "text-vertical",
      "state": "reading",
      "baseline": "baselines/mixed-layout-text-desktop.png",
      "note": "Half of this pair. A mixed-layout publication on one of its reflowable chapters."
    },
    {
      "id": "mixed-layout-plate-desktop",
      "source": {
        "kind": "fixture",
        "file": "mixed-layout.epub"
      },
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "contentType": "text-vertical",
      "state": "reading",
      "baseline": "baselines/mixed-layout-plate-desktop.png",
      "note": "The other half, after turning into a pre-paginated plate in the same book. Reader chrome is publication-scoped, so everything outside the reading surface must be pixel-identical to mixed-layout-text-desktop; only the book content may differ. Diff the two baselines to check it."
    },
    {
      "id": "text-vertical-tablet-search",
      "source": {
        "kind": "real-world",
