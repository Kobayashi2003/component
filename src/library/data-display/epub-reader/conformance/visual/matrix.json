{
  "version": 1,
  "route": "#/entry/data-display/epub-reader",
  "resultDirectory": ".test-results/visual",
  "cases": [
    {
      "id": "empty-desktop",
      "source": {
        "kind": "none"
      },
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "contentType": "empty",
      "state": "empty"
    },
    {
      "id": "loading-large-desktop",
      "source": {
        "kind": "real-world",
        "selector": "largest-fixed-layout"
      },
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "contentType": "fixed-rtl",
      "state": "loading",
      "localOnly": true
    },
    {
      "id": "text-horizontal-desktop",
      "source": {
        "kind": "fixture",
        "file": "valid-reflowable.epub"
      },
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "contentType": "text-horizontal",
      "state": "reading",
      "baseline": "baselines/text-horizontal-desktop.png"
    },
    {
